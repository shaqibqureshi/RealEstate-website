# Copy this file to .env and fill in real values. .env is git-ignored.

# Set to "false" on the live server, "true" for local development.
DJANGO_DEBUG=true

# Generate a real secret with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated hostnames your site answers on.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to POST (https://yourdomain.com). Required when DEBUG=false.
CSRF_TRUSTED_ORIGINS=

# Email: use the SMTP backend on production, console locally.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Marina Realty <noreply@example.com>

# Where appointment notifications should go.
CONTACT_TO_EMAIL=shamrozqureshiabc@gmail.com